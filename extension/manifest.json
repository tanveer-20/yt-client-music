{
  "manifest_version": 3,
  "name": "Rem Companion",
  "version": "0.2.1",
  "description": "Plays Rem audio directly from YouTube in your browser, with header rewriting and future account features.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "cookies",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://*.googleusercontent.com/*",
    "https://rem-mocha.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://rem-mocha.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js"],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://rem-mocha.vercel.app/*"
      ]
    }
  ],
  "action": {
    "default_title": "Rem Companion"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@rem-mocha.vercel.app",
      "strict_min_version": "115.0"
    }
  }
}
